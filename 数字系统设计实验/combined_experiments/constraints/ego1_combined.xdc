# Combined experiments: EGO1 + MS9280 + MS9708
set_property PACKAGE_PIN P17 [get_ports {clk_in}]
set_property PACKAGE_PIN P15 [get_ports {sys_rst_n}]
set_property PACKAGE_PIN H17 [get_ports {clk_ad}]
set_property PACKAGE_PIN H16 [get_ports {ad_in[0]}]
set_property PACKAGE_PIN F16 [get_ports {ad_in[1]}]
set_property PACKAGE_PIN F15 [get_ports {ad_in[2]}]
set_property PACKAGE_PIN G14 [get_ports {ad_in[3]}]
set_property PACKAGE_PIN H14 [get_ports {ad_in[4]}]
set_property PACKAGE_PIN D17 [get_ports {ad_in[5]}]
set_property PACKAGE_PIN E17 [get_ports {ad_in[6]}]
set_property PACKAGE_PIN J13 [get_ports {ad_in[7]}]
set_property PACKAGE_PIN K13 [get_ports {ad_in[8]}]
set_property PACKAGE_PIN G17 [get_ports {ad_in[9]}]
set_property PACKAGE_PIN G2 [get_ports {seg_cs_pin[0]}]
set_property PACKAGE_PIN C2 [get_ports {seg_cs_pin[1]}]
set_property PACKAGE_PIN C1 [get_ports {seg_cs_pin[2]}]
set_property PACKAGE_PIN H1 [get_ports {seg_cs_pin[3]}]
set_property PACKAGE_PIN G1 [get_ports {seg_cs_pin[4]}]
set_property PACKAGE_PIN F1 [get_ports {seg_cs_pin[5]}]
set_property PACKAGE_PIN E1 [get_ports {seg_cs_pin[6]}]
set_property PACKAGE_PIN G6 [get_ports {seg_cs_pin[7]}]
set_property PACKAGE_PIN B4 [get_ports {seg_data_0_pin[0]}]
set_property PACKAGE_PIN A4 [get_ports {seg_data_0_pin[1]}]
set_property PACKAGE_PIN A3 [get_ports {seg_data_0_pin[2]}]
set_property PACKAGE_PIN B1 [get_ports {seg_data_0_pin[3]}]
set_property PACKAGE_PIN A1 [get_ports {seg_data_0_pin[4]}]
set_property PACKAGE_PIN B3 [get_ports {seg_data_0_pin[5]}]
set_property PACKAGE_PIN B2 [get_ports {seg_data_0_pin[6]}]
set_property PACKAGE_PIN D5 [get_ports {seg_data_0_pin[7]}]
set_property PACKAGE_PIN D4 [get_ports {seg_data_1_pin[0]}]
set_property PACKAGE_PIN E3 [get_ports {seg_data_1_pin[1]}]
set_property PACKAGE_PIN D3 [get_ports {seg_data_1_pin[2]}]
set_property PACKAGE_PIN F4 [get_ports {seg_data_1_pin[3]}]
set_property PACKAGE_PIN F3 [get_ports {seg_data_1_pin[4]}]
set_property PACKAGE_PIN E2 [get_ports {seg_data_1_pin[5]}]
set_property PACKAGE_PIN D2 [get_ports {seg_data_1_pin[6]}]
set_property PACKAGE_PIN H2 [get_ports {seg_data_1_pin[7]}]
set_property PACKAGE_PIN B16 [get_ports {clk_da}]
set_property PACKAGE_PIN F13 [get_ports {dac_data[0]}]
set_property PACKAGE_PIN A18 [get_ports {dac_data[1]}]
set_property PACKAGE_PIN B18 [get_ports {dac_data[2]}]
set_property PACKAGE_PIN A14 [get_ports {dac_data[3]}]
set_property PACKAGE_PIN A13 [get_ports {dac_data[4]}]
set_property PACKAGE_PIN A16 [get_ports {dac_data[5]}]
set_property PACKAGE_PIN A15 [get_ports {dac_data[6]}]
set_property PACKAGE_PIN B17 [get_ports {dac_data[7]}]

# Combined UI: S0 and RST share one global reset; all eight DIP switches with exact mode codes.
set_property PACKAGE_PIN R11 [get_ports rst]
set_property PACKAGE_PIN P5 [get_ports {sw[0]}]
set_property PACKAGE_PIN P4 [get_ports {sw[1]}]
set_property PACKAGE_PIN P3 [get_ports {sw[2]}]
set_property PACKAGE_PIN P2 [get_ports {sw[3]}]
set_property PACKAGE_PIN R2 [get_ports {sw[4]}]
set_property PACKAGE_PIN M4 [get_ports {sw[5]}]
set_property PACKAGE_PIN N4 [get_ports {sw[6]}]
set_property PACKAGE_PIN R1 [get_ports {sw[7]}]
set_property PACKAGE_PIN U3 [get_ports {dip[0]}]
set_property PACKAGE_PIN U2 [get_ports {dip[1]}]
set_property PACKAGE_PIN V2 [get_ports {dip[2]}]
set_property PACKAGE_PIN V5 [get_ports {dip[3]}]
set_property PACKAGE_PIN V4 [get_ports {dip[4]}]
set_property PACKAGE_PIN R3 [get_ports {dip[5]}]
set_property PACKAGE_PIN T3 [get_ports {dip[6]}]
set_property PACKAGE_PIN T5 [get_ports {dip[7]}]
set_property PACKAGE_PIN J2 [get_ports clk_10mhz]
set_property PACKAGE_PIN J3 [get_ports clk_1khz]

set_property IOSTANDARD LVCMOS33 [get_ports *]
set_property CFGBVS VCCO [current_design]
set_property CONFIG_VOLTAGE 3.3 [current_design]
create_clock -name sys_clk -period 10.000 [get_ports clk_in]
create_generated_clock -name adc_clk -source [get_ports clk_in] -edges {11 21 31} [get_ports clk_ad]
# MS9280 output delay plus board skew; capture at phase 4 (40 ns after falling edge).
set_input_delay -clock adc_clk -clock_fall -max 30.000 [get_ports {ad_in[*]}]
set_input_delay -clock adc_clk -clock_fall -min 2.000 [get_ports {ad_in[*]}]
set_multicycle_path 4 -setup -end -from [get_ports {ad_in[*]}] -to [get_clocks sys_clk]
set_multicycle_path 3 -hold -end -from [get_ports {ad_in[*]}] -to [get_clocks sys_clk]
set_false_path -from [get_ports sys_rst_n]
set_false_path -to [get_ports {seg_cs_pin[*] seg_data_0_pin[*] seg_data_1_pin[*]}]
set_property SLEW SLOW [get_ports {seg_cs_pin[*] seg_data_0_pin[*] seg_data_1_pin[*]}]
create_generated_clock -name dac_clk -source [get_ports clk_in] -edges {11 21 31} [get_ports clk_da]
set_output_delay -clock dac_clk -max 4.000 [get_ports {dac_data[*]}]
set_output_delay -clock dac_clk -min -2.000 [get_ports {dac_data[*]}]
# CE launch at 0 ns, capture at 50 ns, next data launch at 100 ns.
set_multicycle_path 5 -setup -start -from [get_clocks sys_clk] -to [get_ports {dac_data[*]}]
set_multicycle_path 9 -hold -start -from [get_clocks sys_clk] -to [get_ports {dac_data[*]}]
set_property DRIVE 8 [get_ports {clk_ad clk_da dac_data[*]}]

set_false_path -from [get_ports {rst sw[*] dip[*]}]
create_generated_clock -name divided_10mhz -source [get_ports clk_in] -edges {11 21 31} [get_ports clk_10mhz]
create_generated_clock -name divided_1khz -source [get_ports clk_in] -divide_by 100000 [get_ports clk_1khz]
set_property SLEW SLOW [get_ports {clk_10mhz clk_1khz}]
set_property DRIVE 8 [get_ports {clk_10mhz clk_1khz}]
